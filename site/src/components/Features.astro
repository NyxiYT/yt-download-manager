---
// "Built for how you watch.": six cards in a grid (3 x 2 on desktop, 2 columns on tablets, 1 on phones). Each card
// holds a small piece of the product's interface (CSS animations, started by .play). One card plays at a time:
// a spotlight cycles through them in order; hovering a card plays and loops it; on phones the card nearest the
// middle of the screen plays (scripts/features.ts). Under the grid, the smaller features as chips.
import { AI } from '../lib/anim-icons';
import { features } from '../lib/content';
const chipIcon = { Thumbnails: 'image', Subtitles: 'captions', Screenshots: 'camera', 'Shorts in picture-in-picture': 'pip', 'Big Picture': 'corner', Loop: 'loop', 'Light or dark': 'theme' } as const;
// One icon per card, each meaning its card, none twice (BRIEF 7.4).
const cardIcon = { quality: 'res', resume: 'resume', fast: 'bolt', yield: 'yield', members: 'lock', update: 'refresh' } as const;
const rows = [['4320p', '8K'], ['2160p60', '4K'], ['1440p60', '2K'], ['1080p60', 'HD'], ['720p60', 'HD']];
---
<section class="section feats" id="features" aria-labelledby="feat-title">
  <div class="wrap">
    <h2 id="feat-title" class="h2 feats-head" data-reveal>{features.title}</h2>
    <ul class="grid" data-feats>
      {features.cards.map((c, i) => (
        <li class="card" data-card data-ai-host data-reveal style={`--i:${i}`}>
          <div class={`frag frag-${c.id}`} aria-hidden="true">
            {c.id === 'quality' && (
              <div class="fq">
                <div class="fq-list">{rows.map(([q, b], k) => <span class="fq-row" style={`--k:${k}`}><span>{q}</span><b>{b}</b></span>)}</div>
                <span class="fq-hl"></span>
                <span class="fq-tag mono">60 fps · HDR</span>
              </div>
            )}
            {c.id === 'resume' && (
              <div class="fr">
                <span class="fr-bar"><i></i></span>
                <span class="fr-state mono"><span class="a">Downloading</span><span class="b">Restarted</span><span class="c">Downloading</span></span>
                <span class="fr-icon" set:html={AI.resume} />
              </div>
            )}
            {c.id === 'fast' && (
              <div class="ff">
                {[0, 1, 2, 3].map((k) => <span class="ff-seg" style={`--k:${k}`}><i></i></span>)}
              </div>
            )}
            {c.id === 'yield' && (
              <div class="fy">
                <span class="fy-player"><i class="fy-buf"></i><i class="fy-head"></i></span>
                <span class="fy-row mono"><span>Your video</span><span class="fy-ok">smooth</span></span>
                <span class="fy-dl"><i></i></span>
                <span class="fy-row mono"><span>Download</span><span class="fy-slow"><span class="a">full speed</span><span class="b">making room</span></span></span>
              </div>
            )}
            {c.id === 'members' && (
              <div class="fm">
                <span class="fm-title">Members-only video</span>
                <span class="fm-chips"><span class="chip-age">Age-restricted</span><span class="chip-st"><span class="a">Downloading</span><span class="b">Completed</span></span></span>
                <span class="fm-bar"><i></i></span>
              </div>
            )}
            {c.id === 'update' && (
              <div class="fu">
                <span class="fu-row"><span>A new version is out</span><span class="fu-btn"><span class="a">Update</span><span class="b" set:html={AI.download} /></span></span>
                <span class="fu-row fu-ext"><span>Browser extension</span><span class="fu-dot"></span></span>
              </div>
            )}
          </div>
          <div class="card-text">
            <h3><span set:html={AI[cardIcon[c.id]]} />{c.title}</h3>
            <p>{c.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <ul class="chips" data-play>
      {features.chips.map((c, i) => <li class="chip" data-ai-host style={`--i:${i}`}><span set:html={AI[chipIcon[c]]} />{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .feats-head { margin-bottom: clamp(32px, 4vw, 48px); }
  /* 3 x 2, then 2 columns, then 1. No sideways scrolling anywhere. */
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 1023px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .card { position: relative; display: grid; grid-template-rows: auto 1fr; border-radius: var(--radius-l); background: var(--surface); border: 1px solid var(--line); overflow: hidden;
    transition: border-color .4s var(--ease-out), box-shadow .5s var(--ease-out); }
  /* The spotlight: a soft blue light on the playing card's border. */
  .card[data-spot] { border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent), 0 18px 60px -24px var(--accent-glow), inset 0 1px 0 color-mix(in srgb, var(--accent-hi) 25%, transparent); }
  .card-text { padding: 18px 22px 22px; display: grid; gap: 6px; align-content: start; }
  .card-text h3 { display: flex; align-items: center; gap: 10px; font-size: 1.375rem; letter-spacing: -0.025em; line-height: 1.1; }
  .card-text h3 :global(.ai) { color: var(--accent-hi); }
  .card-text p { color: var(--muted); font-size: 1rem; line-height: 1.5; }
  .frag { position: relative; aspect-ratio: 4 / 3; margin: 14px 14px 0; border-radius: 16px; background: radial-gradient(120% 100% at 50% 0%, color-mix(in srgb, var(--accent) 16%, var(--surface-2)), var(--surface-2)); overflow: hidden;
    display: grid; place-items: center; padding: 22px; font-size: 1rem; color: var(--text); }
  .frag > div { width: 100%; max-width: 250px !important; }
  .frag .mono { font-size: 0.75rem; color: var(--muted); }

  /* Up to 8K: the list settles on its top row */
  .fq { position: relative; width: 100%; max-width: 230px; display: grid; gap: 10px; }
  .fq-list { display: grid; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); padding: 6px 0; }
  .fq-row { display: flex; align-items: baseline; gap: 6px; padding: 7px 14px; font-family: var(--font-mono); font-size: 0.8125rem; }
  .fq-row b { font-size: 0.5625rem; color: var(--accent-hi); font-weight: 700; align-self: flex-start; }
  .fq-hl { position: absolute; left: 1px; right: 1px; top: 7px; height: 33px; border-radius: 6px; background: color-mix(in srgb, var(--accent) 22%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translateY(132px); }
  .fq-tag { justify-self: start; opacity: 0; }
  .play .fq-hl { animation: fq 2.4s .2s var(--ease-out) both; }
  .play .fq-tag { animation: show-stay .5s 2.6s both; }
  @keyframes fq { 0% { transform: translateY(132px); } 35% { transform: translateY(99px); } 60% { transform: translateY(33px); } 100% { transform: translateY(0); } }

  /* Keeps going: stops at a restart, then continues where it was */
  .fr { width: 100%; max-width: 230px; display: grid; gap: 12px; justify-items: start; }
  .fr-bar { width: 100%; height: 12px; border-radius: 6px; background: var(--line-2); overflow: hidden; }
  .fr-bar i { display: block; height: 100%; width: 100%; background: var(--accent); border-radius: 4px; transform-origin: 0 50%; transform: scaleX(0); }
  .fr-state { display: grid; } .fr-state > span { grid-area: 1 / 1; opacity: 0; }
  .fr-icon { color: var(--muted); }
  .play .fr-bar i { animation: fr-bar 4s .2s linear both; }
  .play .fr-state .a { animation: show 1.4s .2s both; } .play .fr-state .b { animation: show 1.2s 1.6s both; } .play .fr-state .c { animation: show-stay 1s 2.8s both; }
  .play .fr-icon :global(.m-turn) { animation: spin 1s 1.6s var(--ease-out) both; }
  @keyframes fr-bar { 0% { transform: scaleX(0); } 35% { transform: scaleX(.58); } 65% { transform: scaleX(.58); } 100% { transform: scaleX(1); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes show { 0%, 100% { opacity: 0; } 15%, 85% { opacity: 1; } }
  @keyframes show-stay { from { opacity: 0; } to { opacity: 1; } }

  /* Fast: four parts at once */
  .ff { width: 100%; max-width: 230px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
  .ff-seg { height: 44px; border-radius: 8px; background: var(--line-2); overflow: hidden; }
  .ff-seg i { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }
  .play .ff-seg i { animation: fill 2.4s calc(.2s + var(--k) * .08s) cubic-bezier(.4, 0, .3, 1) both; }
  .play .ff-seg:nth-child(2) i { animation-duration: 2.9s; } .play .ff-seg:nth-child(3) i { animation-duration: 2.2s; } .play .ff-seg:nth-child(4) i { animation-duration: 2.7s; }
  @keyframes fill { to { transform: scaleX(1); } }

  /* Your video comes first */
  .fy { width: 100%; max-width: 230px; display: grid; gap: 8px; }
  .fy-player { position: relative; height: 96px; border-radius: 8px; background: linear-gradient(160deg, #3c5a9e, #12203f 80%); overflow: hidden; }
  :global([data-theme="light"]) .fy-player { background: linear-gradient(160deg, #c9d8fb, #8eaaf0 80%); }
  .fy-buf { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgb(255 255 255 / 0.5); transform-origin: 0 50%; transform: scaleX(.7); }
  .fy-head { position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; background: #fff; transform-origin: 0 50%; transform: scaleX(.2); }
  .fy-row { display: flex; justify-content: space-between; }
  .fy-ok { color: #4CC38A !important; }
  .fy-dl { height: 12px; border-radius: 6px; background: var(--line-2); overflow: hidden; }
  .fy-dl i { display: block; height: 100%; width: 200%; background: repeating-linear-gradient(90deg, var(--accent) 0 10px, var(--accent-hi) 10px 20px); }
  .fy-slow { display: grid; } .fy-slow > span { grid-area: 1 / 1; } .fy-slow .b { opacity: 0; color: var(--accent-hi); }
  .play .fy-buf { animation: buf 4s .2s ease-in-out both; }
  .play .fy-head { animation: head 4s .2s linear both; }
  .play .fy-dl i { animation: stripes 4s .2s cubic-bezier(.2, .7, .4, 1) both; }
  .play .fy-slow .a { animation: show-out 4s .2s both; } .play .fy-slow .b { animation: show-mid 4s .2s both; }
  @keyframes buf { 0% { transform: scaleX(.7); } 40% { transform: scaleX(.34); } 100% { transform: scaleX(.9); } }
  @keyframes head { to { transform: scaleX(.32); } }
  @keyframes stripes { 0% { transform: translateX(0); } 30% { transform: translateX(-30%); } 65% { transform: translateX(-34%); } 100% { transform: translateX(-50%); } }
  @keyframes show-out { 0%, 28%, 70%, 100% { opacity: 1; } 32%, 66% { opacity: 0; } }
  @keyframes show-mid { 0%, 28%, 70%, 100% { opacity: 0; } 32%, 66% { opacity: 1; } }

  /* Members and age-restricted: it finishes like any other */
  .fm { width: 100%; max-width: 230px; display: grid; gap: 10px; padding: 14px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); }
  .fm-title { font-weight: 550; }
  .fm-chips { display: flex; gap: 6px; flex-wrap: wrap; font-size: 0.6875rem; font-weight: 600; }
  .fm-chips > span { height: 20px; padding: 0 8px; border-radius: 10px; display: inline-flex; align-items: center; }
  .chip-age { background: color-mix(in srgb, var(--text) 10%, transparent); color: var(--text); }
  .chip-st { display: inline-grid !important; padding: 0 !important; } .chip-st > span { grid-area: 1 / 1; height: 20px; padding: 0 8px; border-radius: 10px; display: inline-flex; align-items: center; }
  .chip-st .a { background: color-mix(in srgb, var(--accent) 20%, transparent); color: var(--accent-hi); }
  .chip-st .b { background: color-mix(in srgb, #4CC38A 18%, transparent); color: #6fd6a0; opacity: 0; }
  .fm-bar { height: 6px; border-radius: 3px; background: var(--line-2); overflow: hidden; }
  .fm-bar i { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(.1); }
  .play .fm-bar i { animation: fill 3s .2s cubic-bezier(.4, 0, .3, 1) both; }
  .play .chip-st .a { animation: show-out2 .4s 3.1s both; } .play .chip-st .b { animation: show-stay .4s 3.1s both; }
  @keyframes show-out2 { to { opacity: 0; } }

  /* Updates itself */
  .fu { width: 100%; max-width: 240px; display: grid; gap: 8px; }
  .fu-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 14px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); font-size: 0.8125rem; }
  .fu-btn { display: inline-grid; place-items: center; min-width: 74px; height: 30px; border-radius: 8px; background: var(--accent-fill); color: var(--on-accent); font-weight: 600; font-size: 0.75rem; }
  .fu-btn > span { grid-area: 1 / 1; }
  .fu-btn .b { opacity: 0; }
  .fu-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--muted); box-shadow: 0 0 0 3px color-mix(in srgb, var(--muted) 25%, transparent); }
  .play .fu-row:first-child { animation: toast-in .5s .2s var(--ease-out) both; }
  .play .fu-btn { animation: press .3s 1.3s both; }
  .play .fu-btn .a { animation: show-out2 .2s 1.5s both; }
  .play .fu-btn .b { animation: show-stay .2s 1.5s both; }
  .play .fu-btn :global(.m-done) { stroke-dashoffset: 0 !important; opacity: 1 !important; transition-delay: 1.65s !important; }
  .play .fu-btn :global(.m-drop), .play .fu-btn :global(.ai-download > path:nth-child(2)) { opacity: 0; transition-delay: 1.5s; }
  .play .fu-dot { animation: dot .4s 2.5s both; }
  @keyframes toast-in { from { opacity: 0; transform: translateY(-10px); } }
  @keyframes press { 50% { transform: scale(.92); } }
  @keyframes dot { to { background: #4CC38A; box-shadow: 0 0 0 3px color-mix(in srgb, #4CC38A 30%, transparent); } }

  .chips { list-style: none; margin: clamp(28px, 4vw, 40px) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px 0 12px; border-radius: 999px; border: 1px solid var(--line-2); background: var(--surface); font-size: 0.9375rem; color: var(--text);
    transition: border-color .2s, transform .3s var(--ease-out); }
  .chip:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .chip :global(.ai) { width: 18px; height: 18px; color: var(--accent-hi); }
  /* Page-level hooks (.js, the motion setting) sit on <html>: :global, or Astro's scoping makes them never match. */
  :global(.js) .chips .chip { opacity: 0; transform: translateY(10px); }
  :global(.js) .chips.play .chip { opacity: 1; transform: none; transition: opacity .5s var(--ease-out), transform .5s var(--ease-out), border-color .2s; transition-delay: calc(var(--i) * 60ms); }
  :global([data-motion="reduced"]) .chips .chip { opacity: 1 !important; transform: none !important; }
</style>

<script>
  import '../scripts/features';
</script>
