---
// Five facts between two hairlines. Not cards, not icons.
import { trust } from '../lib/content';
---
<section class="trust" aria-label="In short">
  <div class="wrap">
    <ul class="trust-row">{trust.map((t, i) => <li data-reveal style={`--i:${i}`}>{t}</li>)}</ul>
  </div>
</section>

<style>
  .trust { padding-top: 8px; }
  .trust-row { list-style: none; margin: 0; padding: 22px 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px 28px;
    border-block: 1px solid var(--line-2); font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: 0.02em; color: var(--muted); }
  .trust-row li { display: flex; align-items: center; gap: 28px; white-space: nowrap; }
  .trust-row li::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); opacity: 0.8; }
  @media (max-width: 640px) { .trust-row { justify-content: flex-start; } .trust-row li { gap: 10px; } }
</style>
