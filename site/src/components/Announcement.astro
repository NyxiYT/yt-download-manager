---
// The leader strip: the latest version and its date, linking to "What's new". Dismissed per version, so it comes
// back for the next release (scripts/ui.ts).
import Icon from './Icon.astro';
import { formatDateShort } from '../lib/format';
import { latestRelease } from '../lib/release';

const { version, date } = await latestRelease();
---
<div class="leader" data-leader={version} role="region" aria-label="Latest release">
  <div class="wrap leader-in">
    <a href="#whats-new" class="leader-link">
      <span class="mono">v<span data-release-version>{version}</span></span>
      <span class="dot" aria-hidden="true"></span>
      <span class="mono" data-release-date-short>{formatDateShort(date)}</span>
      <span class="leader-text">is out. See what's new</span>
      <Icon name="arrow" size={16} />
    </a>
    <button class="leader-close" type="button" aria-label="Dismiss" data-leader-close><Icon name="close" size={18} /></button>
  </div>
</div>
<script is:inline>
  // Before paint: hidden if this version was already dismissed.
  try { var l = document.querySelector('[data-leader]'); if (l && localStorage.getItem('leader') === l.dataset.leader) l.hidden = true; } catch (e) {}
</script>

<style>
  .leader { position: relative; z-index: 60; background: var(--panel); border-bottom: 1px solid var(--rule); font-size: 0.875rem; }
  .leader[hidden] { display: none; }
  .leader-in { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 40px; }
  .leader-link { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink-2); min-width: 0; }
  .leader-link .mono { color: var(--ink); font-size: 0.8125rem; }
  .leader-link:hover .leader-text { color: var(--ink); }
  .leader-link svg { color: var(--tape-text); transition: transform 0.2s var(--ease-tape); }
  .leader-link:hover svg { transform: translateX(3px); }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-3); }
  .leader-close { position: absolute; right: clamp(8px, 2vw, 24px); display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: var(--radius-sm); background: none; color: var(--ink-2); cursor: pointer; }
  .leader-close:hover { color: var(--ink); background: var(--raise); }
  @media (max-width: 520px) { .leader-text { display: none; } .leader-in { justify-content: flex-start; } }
</style>
