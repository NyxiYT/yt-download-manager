---
import Faq from '../islands/Faq';
import { REPO } from '../lib/content';
---
<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container-page max-w-3xl">
    <h2 id="faq-title" class="h-section text-center" data-reveal>Frequently asked questions</h2>
    <div class="mt-12" data-reveal>
      <Faq client:visible />
      <!-- Without JavaScript the accordion can't open: show every answer instead, as the old <details> did. -->
      <noscript><style>#faq [data-slot="accordion-panel"] { display: block !important; height: auto !important; opacity: 1 !important; } #faq .faq-indicator { display: none; }</style></noscript>
    </div>
    <p class="mt-8 text-center text-[var(--muted)]">More answers and fixes for common problems are in the <a href={`${REPO}#faq`}>FAQ</a> and <a href={`${REPO}#troubleshooting`}>troubleshooting</a> sections.</p>
  </div>
</section>

<style is:global>
  .faq { display: grid; gap: 12px; }
  .faq .faq-item { border-radius: var(--radius-md); background: var(--surface); border: 1px solid var(--border); overflow: hidden; }
  .faq .faq-trigger {
    display: flex; width: 100%; align-items: center; gap: 16px; padding: 18px 20px; cursor: pointer; text-align: left;
    font-size: var(--text-base); font-weight: 600; color: var(--foreground); background: transparent; border: 0;
  }
  .faq .faq-trigger:hover { background: var(--surface-secondary); }
  .faq .faq-indicator { margin-left: auto; flex: none; width: 20px; height: 20px; color: var(--muted); transition: transform 350ms var(--ease-spring); }
  .faq .faq-body { padding: 0 20px 18px; color: var(--muted); line-height: 1.6; }
  .faq .accordion__separator, .faq [data-slot="accordion-separator"] { display: none; }
</style>
