---
// The hero: the frame stream fills the back (scripts/frame-stream.ts: YouTube thumbnails drifting down, one now and
// then flying into the download button), fading into the page at the bottom in both themes. In front, the
// player with the toolbar loops the intro while in view and tilts a little with the pointer. The download button
// follows the visitor's system.
import Demo from '../islands/Demo';
import type { VideoData } from '../islands/demo/model';
import video from '../data/videos/aqz-KE-bpKQ.json';
import { DOWNLOAD_X64, EXTENSION_ZIP, SITE_URL, hero } from '../lib/content';
import { film } from '../lib/media';
import { AI } from '../lib/anim-icons';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-back" aria-hidden="true">
    <canvas class="stream" data-stream="hero"></canvas>
    <div class="hero-scrim"></div>
    <canvas class="stream" data-stream-fx="hero"></canvas>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="label hero-eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title" class="hero-title">{hero.title.map((l) => <span>{l}</span>)}</h1>
      <p class="hero-sub">{hero.sub}</p>
      <div class="hero-cta">
        <a class="btn btn-primary os-windows" href={DOWNLOAD_X64} data-download>
          <Fragment set:html={AI.download} />
          {hero.primary}
        </a>
        <a class="btn btn-primary os-other" href={EXTENSION_ZIP} data-download>{hero.extension}</a>
        <span class="os-phone hero-phone">
          <span class="hero-phone-text">{hero.phone}</span>
          <button class="btn btn-primary" type="button" data-copy={SITE_URL}>{hero.copyLink}<span class="sr-only" data-copy-status aria-live="polite"></span></button>
        </span>
        <a class="btn btn-quiet" href="#try">{hero.secondary}</a>
      </div>
      <p class="hero-small">{hero.small}</p>
    </div>
    <figure class="hero-product" aria-label="The download toolbar under a video: the camera button opens the video picker, the top quality is picked, and the download starts.">
      <div class="hero-frame" data-tilt>
        <Demo client:lazy mode="hero" scene="video" data={video as VideoData} film={film} label="The download toolbar under a video" />
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; overflow: clip; padding-block: clamp(120px, 15vh, 168px) clamp(64px, 9vw, 112px); isolation: isolate; }
  /* The background shares the page's ground and fades into it over its bottom 20% (below the download button, where
     downloads land): no edge, no box. */
  .hero-back { position: absolute; inset: 0; z-index: -1; -webkit-mask-image: linear-gradient(180deg, #000 80%, transparent); mask-image: linear-gradient(180deg, #000 80%, transparent); }
  .stream { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* A soft pool of the ground colour behind the copy, so the words stay calm over the tiles. */
  .hero-scrim { position: absolute; inset: 0; background: radial-gradient(70% 80% at 18% 50%, color-mix(in srgb, var(--bg) 82%, transparent), transparent 70%); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); align-items: center; gap: clamp(32px, 5vw, 72px); }
  .hero-copy { display: grid; gap: 22px; justify-items: start; color: var(--text); }
  .hero-eyebrow { color: var(--muted); }
  .hero-title { font-size: clamp(2.75rem, 1.3rem + 3.7vw, 4.75rem); font-weight: 700; letter-spacing: -0.045em; line-height: 0.95; }
  .hero-title span { display: block; }
  .hero-title span + span { color: var(--accent-hi); }
  :global([data-theme="light"]) .hero-title span + span { color: var(--accent); }
  .hero-sub { font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3125rem); color: var(--muted); max-width: 30ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .hero-cta .btn-quiet { color: var(--text); background: color-mix(in srgb, var(--text) 6%, transparent); border-color: var(--line-2); }
  .hero-cta .btn-quiet:hover { background: color-mix(in srgb, var(--text) 11%, transparent); }
  .hero-small { font-size: 0.875rem; color: var(--muted); }
  .os-other, .os-phone { display: none !important; }
  :global([data-os="linux"]) .os-windows, :global([data-os="mac"]) .os-windows, :global([data-os="phone"]) .os-windows { display: none; }
  :global([data-os="linux"]) .os-other, :global([data-os="mac"]) .os-other { display: inline-flex !important; }
  :global([data-os="phone"]) .os-phone { display: inline-flex !important; }
  .hero-phone { align-items: center; gap: 12px; flex-wrap: wrap; }
  .hero-phone-text { font-weight: 550; }

  .hero-product { margin: 0; perspective: 1200px; display: grid; gap: 14px; justify-items: end; }
  .hero-frame { width: 100%; transform-style: preserve-3d; will-change: transform; border-radius: var(--radius-m); box-shadow: 0 40px 120px -30px rgb(0 0 0 / 0.85), 0 0 0 1px var(--line-2), 0 0 90px -20px var(--accent-glow); }
  :global([data-theme="light"]) .hero-frame { box-shadow: 0 40px 100px -40px rgb(12 18 32 / 0.45), 0 0 0 1px var(--line-2), 0 0 90px -20px var(--accent-glow); }
  .hero-frame { position: relative; }

  @media (max-width: 899px) {
    .hero { padding-top: 112px; }
    .hero-grid { grid-template-columns: 1fr; gap: 56px; }
    .hero-product { justify-items: stretch; }
  }
</style>

<script>
  import { frameStream } from '../scripts/frame-stream';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-stream="hero"]');
  const fx = document.querySelector<HTMLCanvasElement>('[data-stream-fx="hero"]');
  // Downloads land on the download button shown for this system (the first visible button; phones show none).
  const button = () => [...document.querySelectorAll<HTMLElement>('.hero-cta .btn')].find((b) => b.getClientRects().length) ?? null;
  if (canvas && fx) frameStream({ canvas, fx, pattern: 'rain', target: button, fallback: (w, h) => ({ x: w * 0.5, y: h * 0.96 }) });
</script>
