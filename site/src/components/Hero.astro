---
// The hero: the headline, the download button for the visitor's system, and the product itself at full width:
// the toolbar under a player, run by a guided cursor until the visitor clicks. The headline's words are split
// here, at build time, and rise in with CSS, so the first paint needs no script and nothing moves (CLS 0).
import { getImage } from 'astro:assets';
import DownloadCta from './DownloadCta.astro';
import Demo from '../islands/Demo.tsx';
import bbb from '../assets/frames/bbb.jpg';
import cover from '../assets/frames/bbb-cover.jpg';
import video from '../data/videos/aqz-KE-bpKQ.json';
import { REPO, hero } from '../lib/content';
import { latestRelease } from '../lib/release';
import type { VideoData } from '../islands/demo/model';

const { version } = await latestRelease();
const [f640, f989, c144] = await Promise.all([
  getImage({ src: bbb, width: 640, format: 'webp', quality: 80 }),
  getImage({ src: bbb, width: 989, format: 'webp', quality: 80 }),
  getImage({ src: cover, width: 144, format: 'webp', quality: 80 }),
]);
const frame = { src: f989.src, srcset: `${f640.src} 640w, ${f989.src} 989w`, width: 989, height: 556, alt: 'A frame of Big Buck Bunny paused in the player' };
const words = hero.title.split(' ');
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero-head">
      <div class="hero-title">
        <p class="label hero-eyebrow"><span>{hero.eyebrow}</span><span class="mono">v<span data-release-version>{version}</span></span></p>
        <h1 id="hero-title">
          <span class="sr-only">{hero.title}</span>
          {words.map((w, i) => <><span class="w" aria-hidden="true" style={`--i:${i}`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}
        </h1>
      </div>
      <div class="hero-side">
        <p class="hero-lead">{hero.lead}</p>
        <DownloadCta id="hero-dl" />
        <a class="hero-src" href={REPO}>Source code on GitHub</a>
      </div>
    </div>
  </div>
  <div class="hero-stage">
    <Demo client:lazy scene="video" data={video as VideoData} frame={frame} cover={c144.src} label="Illustration of the download toolbar under a video" />
    <p class="caption hero-caption">
      {hero.caption} Quality list and sizes as the toolbar shows them for this video with the app running. Picture: <i>Big Buck Bunny</i>, © Blender Foundation, <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>.
    </p>
  </div>
</section>

<style>
  .hero { padding-top: clamp(112px, 14vw, 168px); }
  .hero-head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2.4vw, 32px); row-gap: 36px; align-items: end; }
  .hero-title { grid-column: 1 / span 8; }
  .hero-side { grid-column: 9 / span 4; display: grid; gap: 22px; justify-items: start; padding-bottom: 0.6rem; }
  @media (max-width: 1023px) { .hero-title, .hero-side { grid-column: 1 / -1; } }
  .hero-eyebrow { display: flex; gap: 14px; margin-bottom: 22px; }
  .hero-eyebrow .mono { color: var(--tape-text); letter-spacing: 0.02em; text-transform: none; }
  h1 { font-size: clamp(3.1rem, 0.9rem + 8.2vw, 8.4rem); font-weight: 700; letter-spacing: -0.052em; line-height: 0.9; max-width: 11ch; }
  .w { display: inline-block; animation: rise 0.9s var(--ease-tape) both; animation-delay: calc(0.08s + var(--i) * 0.055s); }
  @keyframes rise { from { opacity: 0; transform: translateY(0.32em); clip-path: inset(0 0 100% 0); } to { opacity: 1; transform: none; clip-path: inset(0 0 -20% 0); } }
  .hero-lead { font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem); line-height: 1.5; color: var(--ink-2); max-width: 36ch; }
  .hero-src { font-size: 0.9375rem; color: var(--ink-2); }
  .hero-stage { width: 100%; max-width: 1304px; margin: clamp(48px, 7vw, 88px) auto 0; padding-inline: clamp(8px, 2vw, 32px); }
  .hero-caption { margin-top: 6px; max-width: 80ch; padding-inline: 4px; }
</style>
