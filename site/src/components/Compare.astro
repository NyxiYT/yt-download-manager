---
// Before and after: the extension alone, and with the Windows app.
import Compare from '../islands/Compare.tsx';
import video from '../data/videos/aqz-KE-bpKQ.json';
import { compare } from '../lib/content';
import type { VideoData } from '../islands/demo/model';
---
<section class="section" id="compare" aria-labelledby="cmp-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="counter">009</span>
      <h2 id="cmp-h">{compare.title}</h2>
      <p class="lede">{compare.lede}</p>
    </div>
    <Compare client:visible data={video as VideoData} left={compare.left} right={compare.right} />
    <p class="caption cmp-note">
      The quality list for <i>Big Buck Bunny</i>, which YouTube offers up to 2160p60. Without the app, the list is what YouTube usually gives the browser; it varies by video.
    </p>
  </div>
</section>

<style>
  :global(.cmp) { border-top: 1px solid var(--rule); }
  :global(.cmp-labels) { display: flex; justify-content: space-between; gap: 24px; padding: 18px 0 22px; }
  :global(.cmp-labels p) { display: grid; gap: 6px; }
  :global(.cmp-labels p:last-child) { text-align: right; }
  :global(.cmp-value) { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.25rem, 1rem + 1vw, 1.875rem); letter-spacing: -0.025em; }
  :global(.cmp-labels p:last-child .cmp-value) { color: var(--tape-text); }
  :global(.cmp-area) { position: relative; border-radius: var(--radius-lg); overflow: hidden; background: #0f0f0f; box-shadow: 0 0 0 1px var(--rule); cursor: ew-resize; touch-action: pan-y; user-select: none; }
  :global(.cmp-side) { padding: clamp(24px, 5vw, 56px) clamp(16px, 8vw, 120px); }
  :global(.cmp-right) { position: absolute; inset: 0; background: #0f0f0f; }
  :global(.cmp-list) { max-width: 520px; margin: 0 auto; background: transparent; }
  :global(.cmp-list .ysd-label) { font-size: 13px; }
  /* The extension's dropdown floats; here it sits in the flow, so it sets the panel's height. */
  :global(.cmp .ysd-dd.cmp-dd) { position: static; animation: none; overflow: visible; }
  :global(.cmp-dd .ysd-dd-item) { cursor: inherit; }
  :global(.cmp-missing .ysd-opt-label) { color: #a0a0a0; font-style: italic; }
  :global(.cmp-missing) { background: repeating-linear-gradient(135deg, transparent 0 6px, rgba(255, 255, 255, .04) 6px 7px); }
  :global(.cmp-seam) { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--tape); pointer-events: none; }
  :global(.cmp-slider) { position: absolute; inset: 0; display: flex; align-items: center; touch-action: none; }
  :global(.cmp-track) { position: relative; flex: 1; height: 100%; }
  :global(.cmp-range) { position: absolute; height: 100%; }
  :global(.cmp-thumb) { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--tape); color: var(--on-tape); box-shadow: 0 6px 24px rgb(0 0 0 / 0.45); cursor: grab; transition: transform 0.15s var(--ease-tape); }
  :global(.cmp-thumb:active) { cursor: grabbing; transform: scale(0.94); }
  :global(.cmp-thumb:focus-visible) { outline: 2px solid var(--label); outline-offset: 3px; }
  .cmp-note { margin-top: 16px; max-width: 72ch; }
</style>
