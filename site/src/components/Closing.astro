---
// "Support the project", the closing call to action and the footer, with every link and the full disclaimer
// of the previous site.
import { REPO, RELEASES, legal } from '../lib/content';
import { STAR_THRESHOLD, latestRelease } from '../lib/release';
import DownloadButton from './DownloadButton.astro';

const release = await latestRelease();
const showStars = (release.stars ?? 0) >= STAR_THRESHOLD;
---
<section id="support" class="section pt-0" aria-labelledby="support-title">
  <div class="container-page">
    <div class="cta card relative mx-auto max-w-5xl overflow-hidden px-4 py-14 text-center sm:px-12 sm:py-20" data-reveal>
      <div class="cta-glow" aria-hidden="true"></div>
      <h2 class="h-section relative">YT Download Manager</h2>
      <p class="lede relative mx-auto mt-4 max-w-[52ch]">Free · No ads · No account · Windows 10 and 11</p>
      <div class="relative mt-9 flex flex-wrap items-center justify-center gap-3">
        <DownloadButton size="lg" />
        <a class="btn btn-secondary btn-lg" href={REPO} data-stars>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="m12 17.27 4.15 2.51c.76.46 1.69-.22 1.49-1.08l-1.1-4.72 3.67-3.18c.67-.58.31-1.68-.57-1.75l-4.83-.41-1.89-4.46c-.34-.81-1.5-.81-1.84 0L9.19 8.63l-4.83.41c-.88.07-1.24 1.17-.57 1.75l3.67 3.18-1.1 4.72c-.2.86.73 1.54 1.49 1.08L12 17.27z" /></svg>
          Star on GitHub <span class="star-count" data-star-count hidden={!showStars}>{showStars ? release.stars : ''}</span>
        </a>
      </div>
      <p class="relative mt-5 text-[length:var(--text-xs)] text-[var(--muted)]"><a href={RELEASES}>All downloads</a></p>
    </div>

    <div class="mx-auto mt-20 max-w-3xl text-center" data-reveal>
      <h2 id="support-title" class="text-[length:var(--text-2xl)] font-bold tracking-tight">Support the project</h2>
      <p class="mt-4 text-[var(--muted)]">This project is free and made in my spare time. If it saves you time, you can <a href={`${REPO}#support-the-project`}>support it with a donation</a>.</p>
    </div>
  </div>
</section>

<footer class="border-t border-[var(--border)] py-10 text-[length:var(--text-sm)] text-[var(--muted)]">
  <div class="container-page grid gap-4">
    <p class="m-0">YT Download Manager is open source under the <a href={`${REPO}/blob/main/LICENSE`}>MIT License</a>.
      Made by <a href="https://github.com/NyxiYT">NyxiYT</a>. <a href={`${REPO}/blob/main/PRIVACY.md`}>Privacy policy</a></p>
    <p class="m-0">{legal}</p>
  </div>
</footer>

<style>
  .cta-glow {
    position: absolute; inset: auto -20% -60% -20%; height: 120%; pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgb(var(--glow) / 0.25), transparent 70%);
  }
  .star-count { padding: 2px 8px; border-radius: 999px; font-size: 12px; background: var(--surface-secondary); font-variant-numeric: tabular-nums; }
</style>
