---
// Facts only, on one ruled line: each value links to where it is written down.
import { facts } from '../lib/content';
---
<section class="trust wrap" aria-label="At a glance">
  <dl>
    {facts.map((f) => (
      <div>
        <dt class="label">{f.k}</dt>
        <dd><a href={f.href}>{f.v}</a></dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .trust { padding-top: clamp(56px, 7vw, 96px); }
  dl { display: grid; grid-template-columns: repeat(6, auto); justify-content: space-between; gap: 18px 28px; margin: 0; padding: 18px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  dl > div { display: grid; gap: 6px; min-width: 0; }
  dd { margin: 0; font-size: 0.9375rem; }
  dd a { text-decoration: none; }
  dd a:hover { text-decoration: underline; }
  @media (max-width: 1023px) { dl { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 520px) { dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
