---
import Faq from '../islands/Faq.tsx';
import { ISSUES, README, faq, faqGroups } from '../lib/content';
---
<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="counter">014</span>
      <h2 id="faq-h">Frequently asked questions.</h2>
    </div>
    <div class="faq-wrap defer">
      <Faq client:visible items={faq} groups={faqGroups} />
      <p class="caption faq-more">More answers and fixes for common problems are in the <a href={`${README.replace('#readme', '')}#faq`}>FAQ</a> and <a href={`${README.replace('#readme', '')}#troubleshooting`}>troubleshooting</a> sections of the README. Something else? <a href={ISSUES}>Open an issue</a>.</p>
    </div>
  </div>
</section>

<style>
  .faq-wrap { max-width: 860px; margin-inline: auto; }
  :global(.faq-group + .faq-group) { margin-top: 48px; }
  :global(.faq-gtitle) { padding-bottom: 12px; border-bottom: 1px solid var(--ink); }
  :global(.faq-item) { border-bottom: 1px solid var(--rule); }
  :global(.faq-h) { margin: 0; font: inherit; letter-spacing: 0; }
  :global(.faq-q) { display: flex; align-items: center; justify-content: space-between; gap: 24px; width: 100%; padding: 20px 0; border: 0; background: none; text-align: left; cursor: pointer; font-family: var(--font-display); font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3125rem); font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; color: var(--ink); }
  :global(.faq-q:hover) { color: var(--tape-text); }
  :global(.faq-mark) { position: relative; flex: none; width: 14px; height: 14px; }
  :global(.faq-mark)::before, :global(.faq-mark)::after { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 2px; border-radius: 1px; background: currentColor; transition: transform 0.3s var(--ease-tape); }
  :global(.faq-mark)::after { transform: rotate(90deg); }
  :global(.faq-q[data-state="open"] .faq-mark)::after { transform: rotate(0deg); }
  :global(.faq-a), :global(.faq-a[hidden]) { display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows 0.32s var(--ease-tape), visibility 0s linear 0.32s; }
  :global(.faq-a[data-state="open"]) { grid-template-rows: 1fr; visibility: visible; transition: grid-template-rows 0.32s var(--ease-tape), visibility 0s; }
  :global(.faq-a > div) { min-height: 0; overflow: hidden; }
  :global(.faq-a p) { color: var(--ink-2); max-width: 68ch; padding-bottom: 12px; }
  :global(.faq-a p:last-child) { padding-bottom: 24px; }
  :global(.faq-a a) { color: var(--ink); }
  .faq-more { margin-top: 32px; }
</style>
