---
// Five questions. The heading stays beside them on wide screens.
import Faq from '../islands/Faq';
import { faq } from '../lib/content';
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <h2 id="faq-title" class="h2 faq-title" data-reveal>FAQ</h2>
    <Faq client:visible items={faq} />
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 32px clamp(32px, 6vw, 96px); align-items: start; }
  .faq-title { position: sticky; top: 110px; }
  :global(.faq-list) { border-top: 1px solid var(--line-2); }
  :global(.faq-item) { border-bottom: 1px solid var(--line-2); }
  :global(.faq-h) { margin: 0; font: inherit; letter-spacing: 0; }
  :global(.faq-q) { display: flex; align-items: center; justify-content: space-between; gap: 24px; width: 100%; padding: 24px 0; border: 0; background: none; text-align: left; cursor: pointer;
    font-family: var(--font-display); font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; color: var(--text); transition: color .15s; }
  :global(.faq-q:hover) { color: var(--accent-hi); }
  :global(.faq-mark) { position: relative; flex: none; width: 14px; height: 14px; }
  :global(.faq-mark)::before, :global(.faq-mark)::after { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 2px; border-radius: 1px; background: currentColor; transition: transform 260ms var(--faq-ease); }
  :global(.faq-mark)::after { transform: rotate(90deg); }
  /* Open: the whole plus turns 45° into a cross. */
  :global(.faq-q[data-state="open"] .faq-mark)::before { transform: rotate(45deg); }
  :global(.faq-q[data-state="open"] .faq-mark)::after { transform: rotate(135deg); }

  /* The answer: Radix measures it into --radix-accordion-content-height; the height animates to and from it. */
  :global(.faq-list) { --faq-ease: cubic-bezier(.22, 1, .36, 1); }
  :global(.faq-a) { overflow: hidden; }
  :global(.faq-a[hidden]) { display: none; }
  :global(.faq-a[data-state="open"]) { animation: faq-open 260ms var(--faq-ease); }
  :global(.faq-a[data-state="closed"]) { animation: faq-close 260ms var(--faq-ease); }
  :global(.faq-a[data-state="open"] p) { animation: faq-in 260ms var(--faq-ease); }
  :global(.faq-a[data-state="closed"] p) { animation: faq-out 260ms var(--faq-ease) forwards; }
  :global(.faq-a p) { color: var(--muted); max-width: 52ch; padding-bottom: 26px; font-size: 1.0625rem; }
  @keyframes faq-open { from { height: 0; } to { height: var(--radix-accordion-content-height); } }
  @keyframes faq-close { from { height: var(--radix-accordion-content-height); } to { height: 0; } }
  @keyframes faq-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes faq-out { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(6px); } }
  @media (max-width: 899px) { .faq-grid { grid-template-columns: 1fr; } .faq-title { position: static; } }
</style>
