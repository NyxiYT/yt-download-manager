---
// Five questions. The heading stays beside them on wide screens.
import Faq from '../islands/Faq';
import { faq } from '../lib/content';
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <h2 id="faq-title" class="h2 faq-title" data-reveal>FAQ</h2>
    <Faq client:visible items={faq} />
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 32px clamp(32px, 6vw, 96px); align-items: start; }
  .faq-title { position: sticky; top: 110px; }
  :global(.faq-list) { border-top: 1px solid var(--line-2); }
  :global(.faq-item) { border-bottom: 1px solid var(--line-2); }
  :global(.faq-h) { margin: 0; font: inherit; letter-spacing: 0; }
  :global(.faq-q) { display: flex; align-items: center; justify-content: space-between; gap: 24px; width: 100%; padding: 24px 0; border: 0; background: none; text-align: left; cursor: pointer;
    font-family: var(--font-display); font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; color: var(--text); transition: color .15s; }
  :global(.faq-q:hover) { color: var(--accent-hi); }
  :global(.faq-mark) { position: relative; flex: none; width: 14px; height: 14px; }
  :global(.faq-mark)::before, :global(.faq-mark)::after { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 2px; border-radius: 1px; background: currentColor; transition: transform .45s cubic-bezier(.34, 1.56, .64, 1); }
  :global(.faq-mark)::after { transform: rotate(90deg); }
  :global(.faq-q[data-state="open"] .faq-mark)::after { transform: rotate(0deg); }
  :global(.faq-a), :global(.faq-a[hidden]) { display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows .45s cubic-bezier(.22, 1, .36, 1), visibility 0s linear .45s; }
  :global(.faq-a[data-state="open"]) { grid-template-rows: 1fr; visibility: visible; transition: grid-template-rows .45s cubic-bezier(.22, 1, .36, 1), visibility 0s; }
  :global(.faq-a > div) { min-height: 0; overflow: hidden; }
  :global(.faq-a p) { color: var(--muted); max-width: 52ch; padding-bottom: 26px; font-size: 1.0625rem; }
  @media (max-width: 899px) { .faq-grid { grid-template-columns: 1fr; } .faq-title { position: static; } }
</style>
