---
// The download button for the visitor's system. The page is built with the Windows button; the script in Base.astro
// sets data-os on <html> before the first paint, and CSS shows the matching variant, so nothing jumps.
// Windows: the 64-bit installer, with 32-bit, Scoop and all downloads under it. Linux and macOS: the extension ZIP
// with the README's note. Phones and tablets: it runs on a PC, with a button that copies the page's address.
import Icon from './Icon.astro';
import { DOWNLOAD_X64, DOWNLOAD_X86, EXTENSION_ZIP, RELEASES, SITE_URL, hero } from '../lib/content';
import { formatMB, latestRelease } from '../lib/release';

interface Props { compact?: boolean; id?: string }
const { compact = false, id = 'dl' } = Astro.props;
const { sizes } = await latestRelease();
---
<div class:list={['cta', { compact }]}>
  <div class="os os-windows">
    <a class="btn btn-primary" href={DOWNLOAD_X64} data-download data-magnetic>
      <Icon name="download" size={20} />
      <span>Download for Windows</span>
      {sizes.x64 && <span class="size">{formatMB(sizes.x64)}</span>}
      <span class="done" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
    </a>
    {!compact && (
      <p class="more">
        64-bit installer · <a href={DOWNLOAD_X86}>32-bit</a> · <a href="#install-scoop" data-tab-link="scoop">Scoop</a> · <a href={RELEASES}>All downloads</a>
      </p>
    )}
  </div>
  <div class="os os-linux os-mac">
    <a class="btn btn-primary" href={EXTENSION_ZIP} data-download data-magnetic>
      <Icon name="download" size={20} />
      <span>Download the extension</span>
      <span class="size">ZIP</span>
      <span class="done" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
    </a>
    {!compact && (
      <p class="more">
        <span class="os-note-linux">{hero.otherOs.linux}</span>
        <span class="os-note-mac">{hero.otherOs.mac}</span>{' '}
        <a href={RELEASES}>All downloads</a>
      </p>
    )}
  </div>
  <div class="os os-touch">
    <p class="touch-note">{hero.otherOs.touch} Open this page on your computer to download it.</p>
    <button class="btn btn-ghost copy-link" type="button" data-copy={SITE_URL} id={`${id}-copy`}>
      <span class="idle-label">Copy the link</span><span class="ok-label">Link copied</span>
    </button>
  </div>
</div>

<style>
  .cta { display: grid; gap: 14px; justify-items: start; }
  .os { display: none; gap: 14px; justify-items: start; }
  :global([data-os="windows"]) .os-windows,
  :global([data-os="linux"]) .os-linux,
  :global([data-os="mac"]) .os-mac,
  :global([data-os="touch"]) .os-touch { display: grid; }
  .os-note-linux, .os-note-mac { display: none; }
  :global([data-os="linux"]) .os-note-linux, :global([data-os="mac"]) .os-note-mac { display: inline; }
  .more { font-size: 0.9375rem; color: var(--ink-2); max-width: 46ch; }
  .more a { color: var(--ink); }
  .touch-note { color: var(--ink-2); max-width: 40ch; }
  .copy-link .ok-label { display: none; }
  .copy-link[data-copied] .ok-label { display: inline; }
  .copy-link[data-copied] .idle-label { display: none; }
</style>
