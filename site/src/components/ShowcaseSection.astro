---
// "See it in action". The frames come from the toolbar screenshot (its video part, without the toolbar), made at
// build time: one per quality step, each at that height's share of the 8K width (an illustration of sharpness).
import { getImage } from 'astro:assets';
import downloadAudio from '../../../docs/images/download-audio.jpg';
import downloadHistory from '../../../docs/images/download-history.png';
import downloadVideo from '../../../docs/images/download-video.jpg';
import shortsMenu from '../../../docs/images/shorts-menu.png';
import toolbar from '../../../docs/images/toolbar.jpg';
import Showcase, { type Shot } from '../islands/Showcase';
import { HEIGHTS } from '../islands/showcase/QualityVisual';

const crop = (width: number) =>
  getImage({ src: toolbar, width, height: Math.round((width * 9) / 16), fit: 'cover', position: 'top', format: 'webp', quality: 80 });

const frames = await Promise.all(HEIGHTS.map((h) => crop(Math.max(48, Math.round((h / 4320) * 989)))));
const frame = await crop(640);

// The screenshots of the previous page, beside the moving pictures: AVIF and WebP, at most 400 px wide (twice that
// for sharp screens). Alt texts as before.
const shot = async (src: ImageMetadata, alt: string): Promise<Shot> => {
  const widths = [400, 800].filter((w) => w <= src.width);
  const [avif, webp] = await Promise.all((['avif', 'webp'] as const).map((format) => getImage({ src, widths, format, quality: 70 })));
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src, width: src.width, height: src.height, alt };
};
const shots: Record<string, Shot> = {
  quality: await shot(downloadVideo, 'Choosing the video quality and trimming a clip on YouTube'),
  mp3: await shot(downloadAudio, 'Converting a YouTube video to MP3'),
  shorts: await shot(shortsMenu, 'The Download button and its menu beside a YouTube Short'),
  history: await shot(downloadHistory, 'The download history with finished downloads'),
};
---
<section id="showcase" class="section pb-0" aria-labelledby="showcase-title">
  <div class="container-page mb-12 max-w-3xl text-center pin:mb-0">
    <h2 id="showcase-title" class="h-section">See it in action</h2>
  </div>
  <Showcase client:visible frames={frames.map((f) => f.src)} frame={frame.src} shots={shots} />
</section>
