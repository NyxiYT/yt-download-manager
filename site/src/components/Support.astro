---
// "Made by one person.": a compact split panel, the maker's words on the left, two buttons on the right. The
// QR codes are made here, at build time, as SVG.
import QRCode from 'qrcode';
import Donate from '../islands/Donate';
import { AI } from '../lib/anim-icons';
import { REPO, support } from '../lib/content';

const wallets = await Promise.all(support.wallets.map(async (w) => ({
  id: w.id, name: w.name, address: w.address, warning: 'warning' in w ? w.warning : undefined,
  qr: await QRCode.toString(w.address, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#07080B', light: '#FFFFFF' } }),
})));
---
<section class="section support" id="support" aria-labelledby="sup-title">
  <div class="wrap">
    <div class="sup" data-reveal>
      <div class="sup-left">
        <h2 id="sup-title" class="sup-h">{support.title}</h2>
        <blockquote class="sup-q"><p>“{support.quote}”</p><footer>{support.by}</footer></blockquote>
      </div>
      <div class="sup-right">
        <p class="sup-line">{support.line}</p>
        <div class="sup-btns">
          <Donate client:visible label={support.donate} wallets={wallets} />
          <a class="btn btn-quiet" href={REPO} data-ai-host><Fragment set:html={AI.github} />{support.star}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sup { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); border-radius: var(--radius-l); border: 1px solid var(--line-2); background: var(--surface); overflow: hidden; }
  .sup-left { padding: clamp(28px, 4vw, 48px); display: grid; gap: 24px; align-content: start; }
  .sup-right { padding: clamp(28px, 4vw, 48px); display: grid; gap: 24px; align-content: end; border-left: 1px solid var(--line); background: radial-gradient(120% 120% at 100% 100%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%); }
  .sup-h { font-size: clamp(2rem, 1.4rem + 2vw, 3rem); }
  .sup-q { margin: 0; display: grid; gap: 10px; }
  .sup-q p { font-family: var(--font-display); font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.75rem); line-height: 1.25; letter-spacing: -0.02em; font-weight: 500; }
  .sup-q footer { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--muted); }
  .sup-line { color: var(--muted); font-size: 1.0625rem; max-width: 34ch; }
  .sup-btns { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 767px) { .sup { grid-template-columns: 1fr; } .sup-right { border-left: 0; border-top: 1px solid var(--line); } }

  :global(.dlg-overlay) { position: fixed; inset: 0; z-index: 150; background: rgb(7 8 11 / 0.6); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: fade .25s var(--ease-out); }
  :global(.dlg) { position: fixed; z-index: 160; left: 50%; top: 50%; width: min(640px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: auto; transform: translate(-50%, -50%);
    background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--radius-l); box-shadow: var(--shadow); padding: 24px; animation: rise .35s var(--ease-out); }
  :global(.dlg-head) { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  :global(.dlg-title) { margin: 0; font-family: var(--font-display); font-size: 1.75rem; letter-spacing: -0.02em; }
  :global(.dlg-x) { display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 10px; background: none; color: var(--muted); cursor: pointer; }
  :global(.dlg-x:hover) { color: var(--text); background: color-mix(in srgb, var(--text) 8%, transparent); }
  :global(.dlg-wallets) { display: grid; gap: 16px; }
  :global(.wallet) { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 18px; align-items: start; padding: 16px; border-radius: var(--radius-m); background: var(--surface-2); }
  :global(.wallet-qr) { width: 132px; height: 132px; border-radius: 10px; overflow: hidden; background: #fff; }
  :global(.wallet-qr svg) { width: 100%; height: 100%; }
  :global(.wallet-info) { display: grid; gap: 10px; justify-items: start; min-width: 0; }
  :global(.wallet-name) { font-weight: 600; }
  :global(.wallet-addr) { font-family: var(--font-mono); font-size: 0.8125rem; word-break: break-all; color: var(--muted); }
  :global(.wallet-warn) { font-size: 0.875rem; color: var(--text); padding-left: 12px; border-left: 2px solid var(--accent); }
  @media (max-width: 480px) { :global(.wallet) { grid-template-columns: 1fr; } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes rise { from { opacity: 0; transform: translate(-50%, calc(-50% + 16px)); } }
</style>
