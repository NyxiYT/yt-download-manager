---
// The footer (BRIEF 8.12): the brand on the left (logo, one line, a small Download button), four link columns
// (Product, Help, Project, Legal), and under a hairline the legal line on the left and the film's credit on the
// right. No settings here: they are in the nav (Toggles.astro). Links that leave the page open in a new tab.
import { appIcon } from '../lib/app-icon';
import { DOWNLOAD_X64, EXTENSION_ZIP, footer } from '../lib/content';
const ext = (href: string) => href.startsWith('http');
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <span class="foot-name"><span class="foot-mark" set:html={appIcon('foot', 32)} />YT Download Manager</span>
        <p class="foot-line">{footer.brand}</p>
        <a class="btn btn-primary btn-sm foot-dl os-win" href={DOWNLOAD_X64} target="_blank" rel="noopener noreferrer" data-download>{footer.download}</a>
        <a class="btn btn-primary btn-sm foot-dl os-ext" href={EXTENSION_ZIP} target="_blank" rel="noopener noreferrer" data-download>{footer.download}</a>
      </div>
      {footer.columns.map((c) => (
        <nav class="foot-col" aria-label={c.title}>
          <p class="foot-h">{c.title}</p>
          <ul>{c.links.map((l) => <li><a href={l.href} target={ext(l.href) ? '_blank' : undefined} rel={ext(l.href) ? 'noopener noreferrer' : undefined}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="foot-bottom">
      <p>{footer.legal}</p>
      <p><a href={footer.creditHref} target="_blank" rel="noopener noreferrer">Big Buck Bunny</a>, © Blender Foundation, <a href={footer.licenseHref} target="_blank" rel="noopener noreferrer">CC BY 3.0</a>.</p>
    </div>
  </div>
</footer>

<style>
  .foot { margin-top: clamp(40px, 6vw, 72px); padding-block: 56px 36px; font-size: 0.9375rem; }
  .foot-top { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr)); gap: 40px 32px; align-items: start; }
  .foot-brand { display: grid; gap: 12px; justify-items: start; }
  .foot-name { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 650; font-size: 1.0625rem; letter-spacing: -0.02em; }
  .foot-mark { width: 32px; height: 32px; display: block; }
  .foot-line { color: var(--muted); max-width: 26ch; }
  .foot-dl { margin-top: 4px; }
  .foot-h { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .foot-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .foot-col a { color: var(--text); text-decoration: none; }
  .foot-col a:hover { color: var(--accent-hi); text-decoration: underline; text-underline-offset: 4px; }
  .foot-bottom { display: flex; justify-content: space-between; gap: 8px 32px; flex-wrap: wrap; margin-top: 48px; padding-top: 22px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.875rem; }
  .foot-bottom a { color: var(--muted); }
  .foot-bottom a:hover { color: var(--text); }
  /* The download follows the visitor's system, like the hero's. */
  .os-ext { display: none !important; }
  :global([data-os="linux"]) .os-win, :global([data-os="mac"]) .os-win { display: none; }
  :global([data-os="linux"]) .os-ext, :global([data-os="mac"]) .os-ext { display: inline-flex !important; }
  :global([data-os="phone"]) .foot-dl { display: none !important; }
  @media (max-width: 1023px) { .foot-top { grid-template-columns: repeat(4, minmax(0, 1fr)); } .foot-brand { grid-column: 1 / -1; } }
  @media (max-width: 639px) { .foot-top { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
