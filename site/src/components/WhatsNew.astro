---
// The last five releases from CHANGELOG.md, read while building: the dates in a rail, the new things beside them.
import { CHANGELOG, RELEASES } from '../lib/content';
import { recentReleases } from '../lib/changelog';
import { formatDateShort } from '../lib/format';

const releases = await recentReleases(5);
const plural = (n: number, label: string) => `${n} ${label === 'Fixed' ? (n === 1 ? 'fix' : 'fixes') : label === 'New' ? 'new' : label === 'Changed' ? (n === 1 ? 'change' : 'changes') : label.toLowerCase()}`;
---
<section class="section" id="whats-new" aria-labelledby="wn-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="counter">013</span>
      <h2 id="wn-h">What's new.</h2>
      <p class="lede">The last five releases. The app updates itself, and the browser extension follows on its own.</p>
    </div>
    <ol class="rail defer">
      {releases.map((r, i) => (
        <li class:list={{ latest: i === 0 }}>
          <time class="mono" datetime={r.date}>{formatDateShort(r.date)}</time>
          <div class="rel">
            <h3><span class="mono">v{r.version}</span>{i === 0 && <span class="tag tag-tape">Latest</span>}</h3>
            <ul>{r.headlines.map((h) => <li>{h}</li>)}</ul>
            <p class="counts mono">{r.counts.map((c) => plural(c.n, c.label)).join(' · ')}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="more"><a href={CHANGELOG}>The full changelog</a> · <a href={RELEASES}>All releases on GitHub</a></p>
  </div>
</section>

<style>
  .rail { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .rail > li { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2.4vw, 32px); padding: 28px 0; border-bottom: 1px solid var(--rule); }
  time { grid-column: 1 / span 2; font-size: 0.875rem; color: var(--ink-2); padding-top: 0.35em; }
  .latest time { color: var(--tape-text); }
  .rel { grid-column: 3 / span 8; display: grid; gap: 12px; }
  h3 { display: flex; align-items: center; gap: 12px; font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem); }
  h3 .mono { font-family: var(--font-display); font-variant-numeric: tabular-nums; }
  .rel ul { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; color: var(--ink-2); max-width: 70ch; }
  .rel ul li::marker { color: var(--ink-3); }
  .counts { font-size: 0.75rem; color: var(--ink-2); letter-spacing: 0.04em; }
  @media (max-width: 767px) { time, .rel { grid-column: 1 / -1; } time { margin-bottom: 8px; } }
  .more { margin-top: 24px; font-size: 0.9375rem; color: var(--ink-2); }
  .more a { color: var(--ink); }
</style>
