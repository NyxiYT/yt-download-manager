---
// "How to install": the five steps word for word, each with its screenshot; a line fills as the visitor scrolls
// (scripts/interact.ts). Then "Unsigned builds and checksums" with a copy button for each command.
import { Picture } from 'astro:assets';
import appWindow from '../../../docs/images/app-window-not-connected.png';
import extensionsPage from '../../../docs/images/install-4-extensions-page.png';
import setup from '../../../docs/images/install-1-setup.png';
import ready from '../../../docs/images/install-3-ready.png';
import toolbar from '../../../docs/images/toolbar.jpg';
import { DOWNLOAD_X64, DOWNLOAD_X86, REPO, SUMS, checksumCommands } from '../lib/content';
import Icon from './Icon.astro';
---
<section id="install" class="section" aria-labelledby="install-title">
  <div class="container-page">
    <h2 id="install-title" class="h-section text-center" data-reveal>How to install</h2>

    <ol class="stepper relative mx-auto mt-14 max-w-5xl list-none p-0" data-stepper>
      <span class="stepper-rail" aria-hidden="true"><span class="stepper-fill" data-stepper-fill></span></span>

      <li class="step" data-reveal>
        <span class="step-n" aria-hidden="true">1</span>
        <div class="step-text">
          <p>Download <a href={DOWNLOAD_X64}>YTDownloadManager-Setup-x64.exe</a> (or the <a href={DOWNLOAD_X86}>32-bit version</a>) and open it.</p>
        </div>
        <div class="step-media">
          <Picture src={setup} formats={['avif', 'webp']} alt="The setup window with the Install button" widths={[422]} class="shot max-w-[422px]" loading="lazy" />
        </div>
      </li>

      <li class="step" data-reveal>
        <span class="step-n" aria-hidden="true">2</span>
        <div class="step-text">
          <p>If Windows says "Windows protected your PC", click <b>More info</b>, then <b>Run anyway</b>.</p>
        </div>
        <div class="step-media">
          <!-- A drawing of the warning, not a screenshot. -->
          <div class="smartscreen" role="img" aria-label="Drawing of the Windows warning: Windows protected your PC, with the More info link and the Run anyway button">
            <p class="m-0 text-[22px] font-light">Windows protected your PC</p>
            <p class="m-0 mt-3 text-[13px] opacity-85">Microsoft Defender SmartScreen prevented an unrecognized app from starting.</p>
            <span class="mt-3 inline-block text-[13px] underline">More info</span>
            <span class="mt-8 flex justify-end gap-2"><span class="ss-btn">Run anyway</span><span class="ss-btn ss-btn-alt">Don't run</span></span>
          </div>
        </div>
      </li>

      <li class="step" data-reveal>
        <span class="step-n" aria-hidden="true">3</span>
        <div class="step-text">
          <p>Click <b>Install</b>, then <b>Open</b>.</p>
        </div>
        <div class="step-media">
          <Picture src={ready} formats={['avif', 'webp']} alt="The setup window when the installation is done, with the Open button" widths={[422]} class="shot max-w-[422px]" loading="lazy" />
        </div>
      </li>

      <li class="step" data-reveal>
        <span class="step-n" aria-hidden="true">4</span>
        <div class="step-text">
          <p>In the app, click <b>Add to browser</b>. On the extensions page, turn on <b>Developer mode</b>, click <b>Load unpacked</b>, paste the copied folder path and click <b>Select Folder</b>.</p>
        </div>
        <div class="step-media grid gap-3">
          <Picture src={appWindow} formats={['avif', 'webp']} alt="The app window with the Add to browser button" widths={[445]} class="shot max-w-[300px]" loading="lazy" />
          <Picture src={extensionsPage} formats={['avif', 'webp']} alt="The browser's extensions page with Developer mode and Load unpacked" widths={[640, 1280]} sizes="(max-width: 1024px) calc(100vw - 32px), 520px" class="shot" loading="lazy" />
        </div>
      </li>

      <li class="step" data-reveal>
        <span class="step-n" aria-hidden="true">5</span>
        <div class="step-text">
          <p>Open a YouTube video. The download toolbar appears under it.</p>
        </div>
        <div class="step-media">
          <Picture src={toolbar} formats={['avif', 'webp']} alt="The download toolbar under a YouTube video in dark mode" widths={[480, 680, 989]} sizes="(max-width: 1024px) calc(100vw - 32px), 520px" class="shot" loading="lazy" />
        </div>
      </li>
    </ol>
    <p class="mx-auto mt-10 max-w-3xl text-center text-[var(--muted)]">Step-by-step pictures, updating and uninstalling are explained in the <a href={`${REPO}#installation`}>full guide</a>.</p>

    <div class="card mx-auto mt-16 max-w-3xl p-6 sm:p-8" data-reveal>
      <h3 class="m-0 flex items-center gap-3 text-[length:var(--text-xl)] font-semibold">
        <Icon name="okCircle" class="h-6 w-6 text-[var(--accent-text)]" /> Unsigned builds and checksums
      </h3>
      <p class="mt-4 text-[var(--muted)]">The Windows installers are currently not code-signed. Windows SmartScreen may show a warning the first time you open one: click <b class="text-[var(--foreground)]">More info</b>, then <b class="text-[var(--foreground)]">Run anyway</b>.</p>
      <p class="mt-3 text-[var(--muted)]">Every release ships <a href={SUMS}>SHA256SUMS.txt</a> with the SHA-256 checksum of each file. Compare it with your download:</p>
      <div class="mt-5 grid grid-cols-1 gap-3">
        {checksumCommands.map((c) => (
          <div>
            <div class="mb-1.5 text-[length:var(--text-xs)] font-semibold text-[var(--muted)]">on {c.label}</div>
            <div class="cmd">
              <code class="cmd-text">{c.command}</code>
              <button type="button" class="cmd-copy" data-copy={c.command} aria-label={`Copy the ${c.label} command`}>
                <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] copy-icon" fill="currentColor" aria-hidden="true"><path d="M15 1H4a2 2 0 0 0-2 2v13h2V3h11V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h10v14z" /></svg>
                <Icon name="check" class="h-[18px] w-[18px] copied-icon" />
                <span class="copy-label">Copy</span>
              </button>
            </div>
          </div>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" data-copy-status></p>
    </div>
  </div>
</section>

<style>
  .stepper { display: grid; gap: 56px; }
  .stepper-rail { position: absolute; left: 21px; top: 22px; bottom: 22px; width: 2px; background: var(--border); border-radius: 2px; }
  .stepper-fill { position: absolute; inset: 0; background: var(--accent); transform-origin: top; transform: scaleY(0); border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) { .stepper-fill { transform: none; } }
  .step { position: relative; display: grid; gap: 18px; padding-left: 68px; }
  .step-n {
    position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px;
    font-weight: 700; color: var(--accent-foreground); background: var(--accent); box-shadow: 0 0 0 6px var(--background);
  }
  .step-text p { margin: 8px 0 0; font-size: var(--text-lg); line-height: 1.55; }
  @media (min-width: 1024px) {
    .step { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 48px; align-items: start; }
  }
  .smartscreen { max-width: 420px; padding: 24px; color: #fff; background: #1f6fbf; border-radius: 4px; font-family: "Segoe UI", system-ui, sans-serif; box-shadow: var(--shadow-1); }
  .ss-btn { padding: 6px 16px; font-size: 13px; border: 2px solid rgba(255,255,255,0.85); }
  .ss-btn-alt { background: rgba(255,255,255,0.15); }

  .cmd { display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 14px; border-radius: var(--radius-md); background: var(--field-background); border: 1px solid var(--border); }
  .cmd-text { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; padding: 6px 0; font-size: 13.5px; color: var(--foreground); }
  .cmd-copy {
    display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; border-radius: 999px; flex: none; cursor: pointer;
    font-size: var(--text-xs); font-weight: 600; color: var(--foreground); background: var(--surface-secondary); border: 1px solid var(--border);
  }
  .cmd-copy :global(.copied-icon) { display: none; color: var(--success-text); }
  .cmd-copy[data-copied] :global(.copied-icon) { display: block; }
  .cmd-copy[data-copied] .copy-icon { display: none; }
  .cmd-copy[data-copied] { border-color: var(--success); }
</style>
