---
// "Set up in three steps.": the stepper and each step's loop (islands/InstallSteps.tsx), then the way to the
// extension on its own and to the full guide on GitHub, where versions, Scoop, checksums and the rest live.
import InstallSteps from '../islands/InstallSteps';
import { EXTENSION_ZIP, GUIDE, LINUX_GUIDE, install } from '../lib/content';
---
<section class="section inst" id="install" aria-labelledby="inst-title">
  <div class="wrap">
    <h2 id="inst-title" class="h2 inst-h" data-reveal>{install.title}</h2>
    <InstallSteps client:visible steps={install.steps} labelPrefix="Install step:" />
    <p class="inst-more">
      <a href={LINUX_GUIDE} data-zip={EXTENSION_ZIP}>{install.linux}</a>
      <span aria-hidden="true">·</span>
      <a href={GUIDE}>{install.guide}</a>
    </p>
  </div>
</section>

<style>
  .inst-h { margin-bottom: clamp(32px, 4vw, 56px); }
  :global(.steps) { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  :global(.steps-list) { display: grid; gap: 4px; }
  :global(.step) { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: start; width: 100%; padding: 18px 18px; border: 1px solid transparent; border-radius: var(--radius-m); background: none; text-align: left; cursor: pointer;
    color: var(--muted); transition: background-color .2s, border-color .2s, color .2s; }
  :global(.step:hover) { color: var(--text); }
  :global(.step[aria-selected="true"]) { background: var(--surface); border-color: var(--line-2); color: var(--text); }
  :global(.step-n) { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line-2); font-size: 0.8125rem; }
  :global(.step[aria-selected="true"] .step-n) { background: var(--accent-fill); border-color: var(--accent-fill); color: var(--on-accent); }
  :global(.step-body) { display: grid; gap: 6px; }
  :global(.step-title) { font-family: var(--font-display); font-size: 1.375rem; font-weight: 650; letter-spacing: -0.02em; line-height: 1.15; color: inherit; }
  :global(.step-text) { font-size: 0.9375rem; line-height: 1.5; color: var(--muted); }
  :global(.step-loop) { font-size: 0.75rem; color: var(--muted); padding-top: 6px; }
  :global(.steps-stage) { min-width: 0; display: grid; gap: 14px; }
  :global(.step-now) { display: none; color: var(--muted); }
  :global(.stage-scr) { box-shadow: 0 0 0 1px var(--line-2), var(--shadow); }
  .inst-more { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 32px; color: var(--muted); }
  .inst-more a { color: var(--text); }
  @media (max-width: 899px) {
    :global(.steps) { grid-template-columns: 1fr; }
    :global(.steps-list) { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    :global(.step) { grid-template-columns: 1fr; gap: 8px; padding: 12px; }
    :global(.step-loop) { display: none; }
    :global(.step-text) { display: none !important; }
    :global(.step-now) { display: block; }
  }
</style>
