---
// The bar at the top: fixed, the same height all the time (so nothing below it moves), it only gets a backdrop
// and a border once the page has scrolled. Theme switch and the download button on the right.
import { Image } from 'astro:assets';
import icon from '../../../docs/images/icon.png';
import { DOWNLOAD_X64 } from '../lib/content';
import Icon from './Icon.astro';

const links = [
  { href: '#features', label: 'Features' },
  { href: '#install', label: 'Install' },
  { href: '#faq', label: 'FAQ' },
];
---
<header id="nav" class="nav fixed inset-x-0 top-0 z-50">
  <div class="container-page flex h-[68px] items-center gap-4">
    <a href="#top" class="nav-brand flex items-center gap-2.5 font-semibold text-[var(--foreground)] no-underline">
      <Image src={icon} alt="" width={32} height={32} densities={[1, 2]} class="nav-logo h-8 w-8" loading="eager" />
      <span>YT Download Manager</span>
    </a>
    <nav class="ml-auto hidden md:block" aria-label="Sections">
      <ul class="m-0 flex list-none gap-1 p-0">
        {links.map((l) => <li><a href={l.href} class="nav-link">{l.label}</a></li>)}
      </ul>
    </nav>
    <button type="button" id="theme-toggle" class="nav-icon ml-auto md:ml-2" aria-label="Switch to the light theme" title="Light or dark">
      <Icon name="moon" class="h-5 w-5 theme-moon" />
      <svg viewBox="0 0 24 24" class="h-5 w-5 theme-sun" fill="currentColor" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM2 13h2a1 1 0 1 0 0-2H2a1 1 0 1 0 0 2zm18 0h2a1 1 0 1 0 0-2h-2a1 1 0 1 0 0 2zM11 2v2a1 1 0 1 0 2 0V2a1 1 0 1 0-2 0zm0 18v2a1 1 0 1 0 2 0v-2a1 1 0 1 0-2 0zM5.99 4.58a1 1 0 0 0-1.41 1.41l1.06 1.06a1 1 0 0 0 1.41-1.41L5.99 4.58zm12.37 12.37a1 1 0 0 0-1.41 1.41l1.06 1.06a1 1 0 0 0 1.41-1.41l-1.06-1.06zm1.06-10.96a1 1 0 0 0-1.41-1.41l-1.06 1.06a1 1 0 0 0 1.41 1.41l1.06-1.06zM7.05 18.36a1 1 0 0 0-1.41-1.41l-1.06 1.06a1 1 0 0 0 1.41 1.41l1.06-1.06z" /></svg>
    </button>
    <a href={DOWNLOAD_X64} class="btn btn-primary hidden min-h-[40px] px-4 sm:inline-flex" data-download>
      <Icon name="download" class="h-[18px] w-[18px]" /> Download
    </a>
  </div>
</header>

<style>
  .nav { transition: background-color 250ms ease, border-color 250ms ease; border-bottom: 1px solid transparent; }
  .nav[data-condensed] {
    background: color-mix(in oklab, var(--background) 78%, transparent);
    border-bottom-color: var(--border);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .nav-logo { transition: transform 300ms var(--ease-spring); }
  .nav[data-condensed] .nav-logo { transform: scale(0.88); }
  .nav-link {
    display: inline-flex; align-items: center; height: 40px; padding: 0 14px; border-radius: 999px;
    color: var(--muted); font-size: var(--text-sm); font-weight: 500; text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .nav-link:hover { color: var(--foreground); background: var(--surface); }
  .nav-icon {
    display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; cursor: pointer;
    color: var(--muted); background: transparent; border: 1px solid var(--border);
  }
  .nav-icon:hover { color: var(--foreground); }
  :global([data-theme="dark"] .theme-sun), :global([data-theme="light"] .theme-moon) { display: none; }
</style>

<script>
  // Condensed once the page has scrolled a little.
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.toggleAttribute('data-condensed', window.scrollY > 12);
  requestAnimationFrame(onScroll); // after the first layout, not during parsing (reading scrollY there forces one)
  window.addEventListener('scroll', onScroll, { passive: true });

  // Light or dark, remembered in this browser only.
  const btn = document.getElementById('theme-toggle')!;
  const root = document.documentElement;
  const label = () => btn.setAttribute('aria-label', root.dataset.theme === 'light' ? 'Switch to the dark theme' : 'Switch to the light theme');
  label();
  btn.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', root.dataset.theme === 'light' ? '#f6f7f9' : '#0f0f0f');
    label();
  });
</script>
