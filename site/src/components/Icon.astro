---
// One icon: the site's own set (lib/site-icons.ts) by default, or the extension's (lib/icons.ts) with product.
import { ICONS, type IconName } from '../lib/icons';
import { SITE_ICONS, type SiteIconName } from '../lib/site-icons';

interface Props { name: SiteIconName | IconName; product?: boolean; size?: number; class?: string; label?: string }
const { name, product = false, size = 24, class: cls, label } = Astro.props;
const inner = product ? `<path d="${ICONS[name as IconName]}"/>` : SITE_ICONS[name as SiteIconName];
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" set:html={inner} />
