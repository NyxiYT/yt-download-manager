---
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  label?: string; // only for icons that carry meaning on their own; otherwise hidden from screen readers
}
const { name, class: cls = 'h-5 w-5', label } = Astro.props;
---
<svg viewBox="0 0 24 24" class={cls} fill="currentColor" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false">
  <path d={ICONS[name]} />
</svg>
