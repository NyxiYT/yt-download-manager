---
// The floating glass nav: logo, four links, the Theme and Reduce motion buttons (Toggles.astro), Download. It condenses on scroll (scripts/ui.ts) and bends what's behind
// it in Chromium on capable devices (scripts/glass.ts); elsewhere a blur with the same tint, edge and highlight.
// The hero's file pill flies into its Download button, and a ring fills around it (islands/flight.ts).
import { appIcon } from '../lib/app-icon';
import Toggles from './Toggles.astro';
import { DOWNLOAD_X64, EXTENSION_ZIP, nav, navDownload } from '../lib/content';
---
<header class="nav-shell" data-nav>
  <div class="nav" data-nav-bar>
    <div class="nav-glass" data-glass aria-hidden="true"></div>
    <div class="nav-row">
      <a class="brand" href="#top" data-nav-start>
        <span class="brand-mark" set:html={appIcon('nav', 28)} />
        <span class="brand-word" data-nav-word>YT Download Manager</span>
        <span class="sr-only">, back to top</span>
      </a>
      <nav class="links" aria-label="Sections">
        <ul>{nav.map((n) => <li><a href={n.href} data-nav-link>{n.label}</a></li>)}</ul>
      </nav>
      <div class="actions" data-nav-end>
        <span class="nav-tg"><Toggles where="nav" /></span>
        <a class="btn btn-primary btn-sm nav-dl" href={DOWNLOAD_X64} target="_blank" rel="noopener noreferrer" data-nav-download data-download data-zip={EXTENSION_ZIP}>{navDownload}</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-sheet" data-menu-open aria-label="Open menu">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="sheet" id="nav-sheet" data-menu hidden>
    <div class="sheet-panel" role="dialog" aria-modal="true" aria-label="Menu">
      <button class="sheet-x" type="button" data-menu-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
      <ul>{nav.map((n) => <li><a href={n.href} data-menu-link>{n.label}</a></li>)}</ul>
      <Toggles where="sheet" />
    </div>
  </div>
</header>

<style>
  .nav-shell { position: sticky; top: 0; z-index: 50; height: 0; }
  /* Offset with top, not a margin: a margin would pass through the zero-height shell and push the page down. */
  .nav { position: relative; top: 16px; margin: 0 auto; width: min(1080px, calc(100% - 24px)); height: 60px; }
  .nav-glass {
    position: absolute; inset: 0; border-radius: 18px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--glass-tint) 85%, transparent), var(--glass-tint));
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 1px var(--glass-line), 0 18px 50px -24px rgb(0 0 0 / 0.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.4); backdrop-filter: blur(24px) saturate(1.4);
    clip-path: inset(0 var(--cx, 0px) 0 var(--cx, 0px) round 18px);
    transition: clip-path 0.55s var(--ease-out);
  }
  /* Headings pass under the nav: the glass frosts them (the rim still bends), so the links keep 4.5:1 over any text. */
  .nav-glass[data-refract] { -webkit-backdrop-filter: url(#ydm-glass) blur(20px) saturate(1.4); backdrop-filter: url(#ydm-glass) blur(20px) saturate(1.4); }
  .nav-row { position: relative; height: 100%; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 10px 0 14px; }
  .brand { justify-self: start; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-weight: 650; font-size: 1.0625rem; letter-spacing: -0.02em; transition: transform 0.55s var(--ease-out); }
  .brand-mark { display: block; width: 28px; height: 28px; }
  .brand-word { white-space: nowrap; transition: opacity 0.3s var(--ease-out), clip-path 0.45s var(--ease-out); clip-path: inset(0 0 0 0); }
  .links ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .links a { display: inline-flex; align-items: center; height: 38px; padding: 0 14px; border-radius: 10px; text-decoration: none; font-size: 0.9375rem; color: var(--nav-link); transition: color 0.15s, background-color 0.15s; }
  .links a:hover { color: var(--text); }
  .links a[aria-current="true"] { color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); }
  .actions { justify-self: end; display: flex; align-items: center; gap: 6px; transition: transform 0.55s var(--ease-out); }
  .menu-btn { display: none; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 10px; background: none; color: var(--text); cursor: pointer; }
  .nav[data-condensed] .brand { transform: translateX(var(--dx, 0px)); }
  .nav[data-condensed] .actions { transform: translateX(calc(-1 * var(--dx, 0px))); }
  .nav[data-condensed] .brand-word { opacity: 0; clip-path: inset(0 100% 0 0); }
  @media (max-width: 767px) { .nav { top: 12px; } }
  @media (max-width: 899px) {
    .links, .nav-tg { display: none; } /* on phones the links and both settings are in the menu */
    .nav-row { grid-template-columns: 1fr auto; }
    .menu-btn { display: grid; }
  }
  @media (max-width: 420px) { .brand-word { display: none; } }

  .sheet { position: fixed; inset: 0; z-index: 80; background: color-mix(in srgb, var(--bg) 70%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .sheet[hidden] { display: none; }
  .sheet-panel { position: absolute; inset: 12px 12px auto 12px; background: var(--surface); border: 1px solid var(--line-2); border-radius: 18px; padding: 8px 8px 12px; box-shadow: var(--shadow); }
  .sheet-x { display: grid; place-items: center; margin-left: auto; width: 44px; height: 44px; border: 0; border-radius: 10px; background: none; color: var(--text); cursor: pointer; }
  .sheet ul { list-style: none; margin: 0; padding: 0; }
  .sheet li a { display: block; padding: 14px 12px; border-top: 1px solid var(--line); text-decoration: none; font-family: var(--font-display); font-size: 1.75rem; font-weight: 600; letter-spacing: -0.03em; }
</style>
