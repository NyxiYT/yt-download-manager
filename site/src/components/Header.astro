---
// The floating glass nav. It condenses on scroll with transforms and a clip-path only (scripts/nav.ts), and bends
// what's behind it in Chromium on capable devices (scripts/glass.ts); everywhere else a blur with the same tint,
// border and highlight. The tint keeps its text at AA contrast over any section, light or dark.
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import iconSrc from '../../../docs/images/icon.png';
import { DOWNLOAD_X64, EXTENSION_ZIP, REPO, nav } from '../lib/content';

const logo = await getImage({ src: iconSrc, width: 64, format: 'webp' });
---
<header class="nav-shell" data-nav>
  <div class="nav" data-nav-bar>
    <div class="nav-glass" data-glass aria-hidden="true"></div>
    <div class="nav-row">
      <a class="brand" href="#top" data-nav-start>
        <img src={logo.src} width="28" height="28" alt="" />
        <span class="brand-word" data-nav-word>YT Download Manager</span>
        <span class="sr-only">YT Download Manager, back to top</span>
      </a>
      <nav class="links" aria-label="Sections">
        <ul>
          {nav.map((n) => <li><a href={n.href} data-nav-link>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="actions" data-nav-end>
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to light theme">
          <span class="i-dark"><Icon name="sun" size={20} /></span>
          <span class="i-light"><Icon name="moon" size={20} /></span>
        </button>
        <a class="icon-btn" href={REPO} aria-label="Source code on GitHub"><Icon name="github" size={20} /></a>
        <a class="btn btn-primary btn-sm nav-dl" href={DOWNLOAD_X64} data-nav-download data-zip={EXTENSION_ZIP}>Download</a>
        <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="nav-sheet" data-menu-open aria-label="Open menu"><Icon name="menu" size={22} /></button>
      </div>
    </div>
  </div>
  <div class="sheet" id="nav-sheet" data-menu hidden>
    <div class="sheet-panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="sheet-head">
        <span class="label">Menu</span>
        <button class="icon-btn" type="button" data-menu-close aria-label="Close menu"><Icon name="close" size={22} /></button>
      </div>
      <ul>
        {nav.map((n, i) => <li><a href={n.href} data-menu-link><span class="counter">{String(i + 1).padStart(3, '0')}</span>{n.label}</a></li>)}
        <li><a href={REPO}><span class="counter">GH</span>GitHub</a></li>
      </ul>
    </div>
  </div>
</header>

<style>
  .nav-shell { position: sticky; top: 0; z-index: 50; height: 0; }
  .nav { position: relative; margin: 12px auto 0; width: min(1120px, calc(100% - 24px)); height: 60px; }
  .nav-glass {
    position: absolute; inset: 0; border-radius: var(--radius-xl);
    background: linear-gradient(180deg, color-mix(in srgb, var(--glass-tint) 92%, transparent), var(--glass-tint));
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 1px var(--glass-line), var(--shadow-float);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    clip-path: inset(0 var(--cx, 0px) 0 var(--cx, 0px) round var(--radius-xl));
    transition: clip-path 0.5s var(--ease-tape);
  }
  /* Chromium on a capable device: real refraction through the SVG filter built by scripts/glass.ts. */
  .nav-glass[data-refract] { -webkit-backdrop-filter: url(#ydm-glass) blur(3px) saturate(1.5); backdrop-filter: url(#ydm-glass) blur(3px) saturate(1.5); }
  .nav-row { position: relative; height: 100%; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 10px 0 14px; }
  .brand { justify-self: start; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-weight: 650; font-size: 1.0625rem; letter-spacing: -0.02em; transition: transform 0.5s var(--ease-tape); }
  .brand img { border-radius: 7px; }
  .brand-word { transition: opacity 0.3s var(--ease-tape), clip-path 0.4s var(--ease-tape); clip-path: inset(0 0 0 0); white-space: nowrap; }
  .links ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .links a { display: inline-flex; align-items: center; height: 36px; padding: 0 12px; border-radius: var(--radius-sm); text-decoration: none; font-size: 0.9375rem; color: var(--ink-2); transition: color 0.15s var(--ease-tape), background-color 0.15s var(--ease-tape); }
  .links a:hover { color: var(--ink); }
  .links a[aria-current="true"] { color: var(--ink); background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .actions { justify-self: end; display: flex; align-items: center; gap: 4px; transition: transform 0.5s var(--ease-tape); }
  .icon-btn { display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 10px; background: none; color: var(--ink-2); cursor: pointer; text-decoration: none; transition: color 0.15s var(--ease-tape), background-color 0.15s var(--ease-tape); }
  .icon-btn:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .nav-dl { margin-left: 6px; border-radius: 10px; }
  .i-light { display: none; }
  :global([data-theme="light"]) .i-light { display: block; }
  :global([data-theme="light"]) .i-dark { display: none; }
  .menu-btn { display: none; }

  /* Condensed (scripts/nav.ts sets --cx and --dx from the measured widths). */
  .nav[data-condensed] .brand { transform: translateX(var(--dx, 0px)); }
  .nav[data-condensed] .actions { transform: translateX(calc(-1 * var(--dx, 0px))); }
  .nav[data-condensed] .brand-word { opacity: 0; clip-path: inset(0 100% 0 0); }

  @media (max-width: 899px) {
    .links { display: none; }
    .nav-row { grid-template-columns: 1fr auto; }
    .menu-btn { display: grid; }
    .actions a[aria-label] { display: none; }
  }
  @media (max-width: 420px) { .brand-word { display: none; } }

  .sheet { position: fixed; inset: 0; z-index: 80; background: color-mix(in srgb, var(--ground) 70%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .sheet[hidden] { display: none; }
  .sheet-panel { position: absolute; inset: 12px 12px auto 12px; background: var(--panel); border: 1px solid var(--rule); border-radius: var(--radius-xl); padding: 8px 8px 16px; box-shadow: var(--shadow-float); }
  .sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 4px 4px 4px 12px; }
  .sheet ul { list-style: none; margin: 8px 0 0; padding: 0; }
  .sheet li a { display: flex; align-items: baseline; gap: 16px; padding: 14px 12px; border-top: 1px solid var(--rule); text-decoration: none; font-family: var(--font-display); font-size: 1.75rem; font-weight: 600; letter-spacing: -0.03em; }
  .sheet li a .counter { padding: 0; width: 2.5em; }
</style>
