---
// "How to use", interactive: the README's five chapters, each as a demo and as the real app.
import { getImage } from 'astro:assets';
import Showcase from '../islands/Showcase.tsx';
import bbb from '../assets/frames/bbb.jpg';
import tall from '../assets/frames/bbb-tall.jpg';
import cover from '../assets/frames/bbb-cover.jpg';
import shotVideo from '../../../docs/images/download-video.jpg';
import shotAudio from '../../../docs/images/download-audio.jpg';
import shotShorts from '../../../docs/images/shorts-menu.png';
import shotHistory from '../../../docs/images/download-history.png';
import video from '../data/videos/aqz-KE-bpKQ.json';
import short from '../data/videos/gXWsa1IP71A.json';
import { recordings } from '../data/recordings';
import { chapters } from '../lib/content';
import type { VideoData } from '../islands/demo/model';

const pic = async (src: ImageMetadata, widths: number[], alt: string) => {
  const ws = widths.filter((w) => w <= src.width);
  const list = await Promise.all(ws.map((w) => getImage({ src, width: w, format: 'webp', quality: 82 })));
  return { src: list.at(-1)!.src, srcset: list.map((x, i) => `${x.src} ${ws[i]}w`).join(', '), width: src.width, height: src.height, alt };
};
const frame = await pic(bbb, [640, 989], 'A frame of Big Buck Bunny paused in the player');
const tallFrame = await pic(tall, [313], 'A Short, in the vertical player');
const coverImg = await getImage({ src: cover, width: 144, format: 'webp' });
const shots = {
  video: await pic(shotVideo, [600, 989], 'Choosing the quality to download a YouTube video in up to 8K'),
  trim: await pic(shotVideo, [600, 989], 'The Trim section of the video picker, with the clip set to the full length'),
  audio: await pic(shotAudio, [600, 989], 'Converting a YouTube video to MP3'),
  shorts: await pic(shotShorts, [420, 794], 'Downloading a YouTube Short with the Download button beside it'),
  history: await pic(shotHistory, [400], 'The download history with finished downloads'),
};
---
<section class="section" id="showcase" aria-labelledby="sc-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="counter">007</span>
      <h2 id="sc-h">Every step, as the README says it.</h2>
      <p class="lede">Five chapters from "How to use". Each one plays by itself; click inside it and it's yours. Or switch to the real app.</p>
    </div>
    <Showcase client:visible chapters={[...chapters] as any} video={video as VideoData} short={short as VideoData} frame={frame} tall={tallFrame}
      cover={coverImg.src} shots={shots} recordings={recordings} />
    <p class="caption sc-credit">
      Pictures: <i>Big Buck Bunny</i>, © Blender Foundation, <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>. The Shorts chapter lists the qualities of a 28-second Short by Blender Studio.
    </p>
  </div>
</section>

<style>
  :global(.showcase) { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2.4vw, 32px); }
  :global(.sc-rail) { grid-column: 1 / span 4; position: relative; padding-left: 22px; }
  :global(.showcase:not([data-wide]) .sc-rail) { grid-column: 1 / -1; }
  :global(.sc-progress) { position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--rule); }
  :global(.sc-progress > span) { position: absolute; inset: 0; background: var(--tape); transform-origin: top; transform: scaleY(0); }
  :global(.sc-rail > ol) { list-style: none; margin: 0; padding: 0; }
  /* The chapter in view is in full ink; the others step back in colour, never below AA. */
  :global(.sc-rail > ol > li) { padding: 6vh 0; min-height: 62vh; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  :global(.showcase[data-wide] .sc-rail > ol > li:not(.on) .sc-title) { color: var(--ink-2); }
  :global(.sc-title) { transition: color 0.4s var(--ease-tape); }
  :global(.showcase:not([data-wide]) .sc-rail > ol > li) { min-height: 0; padding: 40px 0; border-top: 1px solid var(--rule); }
  :global(.sc-h3) { margin: 0; font: inherit; letter-spacing: 0; }
  :global(.sc-head) { display: flex; align-items: baseline; gap: 14px; padding: 0; border: 0; background: none; text-align: left; cursor: pointer; }
  :global(.sc-head .counter) { padding: 0; }
  :global(.sc-title) { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.625rem, 1.2rem + 1.2vw, 2.25rem); letter-spacing: -0.03em; line-height: 1.05; }
  :global(.sc-steps) { margin: 0; padding-left: 1.2em; color: var(--ink-2); display: grid; gap: 6px; }
  :global(.sc-steps li::marker) { font-family: var(--font-mono); font-size: 0.8em; color: var(--ink-3); }
  :global(.sc-loop .mono) { color: var(--ink); }
  :global(.sc-stage) { grid-column: 5 / span 8; }
  /* The page is built for wide screens; on narrower ones this stage waits for the island to stack the chapters. */
  @media (max-width: 1023px) { :global(.sc-stage) { display: none; } :global(.sc-rail) { grid-column: 1 / -1; } }
  :global(.sc-sticky) { position: sticky; top: 96px; padding-top: 6vh; }
  :global(.sc-stage-head) { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  :global(.counter-inline) { color: var(--tape-text); }
  :global(.sc-swap) { animation: sc-in 0.45s var(--ease-tape) both; }
  @keyframes sc-in { from { opacity: 0; transform: translateY(10px); } }
  :global(.sc-inline) { display: grid; gap: 14px; margin-top: 8px; }
  :global(.view-switch) { display: inline-flex; padding: 3px; border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); gap: 2px; }
  :global(.view-switch button) { height: 30px; padding: 0 12px; border: 0; border-radius: 4px; background: none; font-size: 0.8125rem; color: var(--ink-2); cursor: pointer; }
  :global(.view-switch button[aria-pressed="true"]) { background: var(--raise); color: var(--ink); }
  :global(.real) { margin: 0; }
  :global(.real img), :global(.real video) { width: 100%; height: auto; border-radius: var(--radius-lg); border: 1px solid var(--rule); background: var(--panel); }
  :global(.real .caption) { margin-top: 10px; }
  .sc-credit { margin-top: 40px; }
</style>
