---
// The page, top to bottom. Each section is in src/components; the interactive parts are React islands in
// src/islands; scripts/ui.ts does the rest without React.
import Faq from '../components/Faq.astro';
import Features from '../components/Features.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Install from '../components/Install.astro';
import OldWay from '../components/OldWay.astro';
import Support from '../components/Support.astro';
import TrustLine from '../components/TrustLine.astro';
import TrySection from '../components/TrySection.astro';
import Base from '../layouts/Base.astro';
import { arrowSvg } from '../lib/arrow';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <TrustLine />
    <TrySection />
    <HowItWorks />
    <Features />
    <OldWay />
    <Install />
    <Faq />
    <Support />
    <FinalCta />
  </main>
  <Footer />
  <div class="cur" aria-hidden="true" data-cursor-el>
    <span class="cur-halo"></span>
    <span class="cur-ripple"></span>
    <span class="cur-arrow" set:html={arrowSvg()} />
    <svg class="cur-hand" viewBox="0 0 24 24" width="24" height="24"><path d="M8.5 11V5.8a1.5 1.5 0 0 1 3 0V10m0-.8V4.5a1.5 1.5 0 0 1 3 0v5m0-.6V6a1.5 1.5 0 0 1 3 0v6.5c0 4.2-2.6 7.5-6.4 7.5-2.4 0-3.9-1-5.3-3.1L4 13.4a1.5 1.5 0 0 1 2.4-1.8l2.1 2.3" fill="#fff" stroke="#0f0f0f" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <span class="cur-pill"><span class="cur-try">Try it</span><svg class="cur-down" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v12m0 0-5-5m5 5 5-5" /></svg></span>
  </div>
</Base>

<script>
  import '../scripts/ui';
</script>
