{
  "version": "1.10.0",
  "description": "Free YouTube downloader for Windows. Download videos in up to 8K quality, MP3, Shorts, thumbnails and subtitles.",
  "homepage": "https://nyxiyt.github.io/yt-download-manager/",
  "license": "MIT",
  "notes": [
    "Open YT Download Manager from the Start menu and click \"Add to browser\" to add its browser extension.",
    "The app updates itself. \"scoop update\" works too."
  ],
  "architecture": {
    "64bit": {
      "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v1.10.0/YTDownloadManager-Setup-x64.exe#/setup.exe",
      "hash": "63152be673df8823da192becbefbc48469bda58e5836deb830a7d9df525a1c80"
    },
    "32bit": {
      "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v1.10.0/YTDownloadManager-Setup-x86.exe#/setup.exe",
      "hash": "cce300643c876969f0061499c60253d10da0fb40d8b953f2148af215df242db3"
    }
  },
  "installer": {
    "file": "setup.exe",
    "args": [
      "--quiet"
    ]
  },
  "uninstaller": {
    "script": [
      "if ($cmd -eq 'uninstall' -and (Test-Path \"$env:LOCALAPPDATA\\Programs\\YT Download Manager\\YTDownloadManager.exe\")) {",
      "    Start-Process \"$env:LOCALAPPDATA\\Programs\\YT Download Manager\\YTDownloadManager.exe\" -ArgumentList '--uninstall', '--quiet' -Wait",
      "}"
    ]
  },
  "checkver": {
    "github": "https://github.com/NyxiYT/yt-download-manager"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v$version/YTDownloadManager-Setup-x64.exe#/setup.exe"
      },
      "32bit": {
        "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v$version/YTDownloadManager-Setup-x86.exe#/setup.exe"
      }
    },
    "hash": {
      "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v$version/SHA256SUMS.txt"
    }
  }
}
