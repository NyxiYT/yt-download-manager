  "architecture": {
    "64bit": {
      "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v1.11.0/YTDownloadManager-Setup-x64.exe#/setup.exe",
      "hash": "c04c5024050dd76a356da0b78138a0d5f720d92d52ad16be882f52e350a681e4"
    },
    "32bit": {
      "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v1.11.0/YTDownloadManager-Setup-x86.exe#/setup.exe",
      "hash": "833fcbff2ffed8908f4de557e6f80c27658756a74759e099bd328597bb0c7899"
    }
  },
  "installer": {
    "file": "setup.exe",
    "args": [
      "--quiet"
    ]
  },
  "uninstaller": {
    "script": [
      "if ($cmd -eq 'uninstall' -and (Test-Path \"$env:LOCALAPPDATA\\Programs\\YT Download Manager\\YTDownloadManager.exe\")) {",
      "    Start-Process \"$env:LOCALAPPDATA\\Programs\\YT Download Manager\\YTDownloadManager.exe\" -ArgumentList '--uninstall', '--quiet' -Wait",
      "}"
    ]
  },
  "checkver": {
    "github": "https://github.com/NyxiYT/yt-download-manager"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v$version/YTDownloadManager-Setup-x64.exe#/setup.exe"
      },
      "32bit": {
        "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v$version/YTDownloadManager-Setup-x86.exe#/setup.exe"
      }
    },
    "hash": {
      "url": "https://github.com/NyxiYT/yt-download-manager/releases/download/v$version/SHA256SUMS.txt"
    }
  }
